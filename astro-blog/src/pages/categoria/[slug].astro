---
/**
 * GSC FIX: /categoria/{x}/ → /tema/{cluster}/  (o home si no hay match)
 * Emite páginas redirect (canonical + refresh + noindex) para consolidar
 * URLs legacy que Google sigue rastreando.
 *
 * IMPORTANTE: getStaticPaths se ejecuta en un módulo aislado en Astro,
 * por eso TODO (mapa legacy incluido) vive adentro y el target se pasa
 * por props. No usar imports del frontmatter acá.
 */
export async function getStaticPaths() {
  const LEGACY_CAT_MAP: Record<string, string> = {
    empleo: 'empleo-habilidades',
    ia: 'ia-para-pymes',
    marketing: 'marketing-crecimiento',
    finanzas: 'finanzas-cashflow',
    operaciones: 'operaciones-procesos',
    ventas: 'ventas-negociacion',
    liderazgo: 'liderazgo-management',
    estrategia: 'estrategia-latam',
    herramientas: 'herramientas-productividad',
    data: 'data-analytics',
    servicios: 'servicios-profesionales-rentabilidad',
    tendencias: 'tendencias-ia-tech',
  };

  const CLUSTER_SLUGS = [
    'empleo-habilidades',
    'ia-para-pymes',
    'servicios-profesionales-rentabilidad',
    'marketing-crecimiento',
    'finanzas-cashflow',
    'operaciones-procesos',
    'ventas-negociacion',
    'liderazgo-management',
    'estrategia-latam',
    'herramientas-productividad',
    'data-analytics',
    'tendencias-ia-tech',
  ];

  const paths: { params: { slug: string }; props: { target: string } }[] = [];
  const seen = new Set<string>();

  for (const [legacy, cluster] of Object.entries(LEGACY_CAT_MAP)) {
    if (seen.has(legacy)) continue;
    seen.add(legacy);
    paths.push({
      params: { slug: legacy },
      props: { target: `https://blog.vistaceo.com/tema/${cluster}/` },
    });
  }

  for (const cluster of CLUSTER_SLUGS) {
    if (seen.has(cluster)) continue;
    seen.add(cluster);
    paths.push({
      params: { slug: cluster },
      props: { target: `https://blog.vistaceo.com/tema/${cluster}/` },
    });
  }

  return paths;
}

const { target } = Astro.props as { target: string };
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<title>Redirigiendo…</title>
<link rel="canonical" href={target} />
<meta name="robots" content="noindex, follow" />
<meta http-equiv="refresh" content={`0; url=${target}`} />
<script is:inline set:html={`window.location.replace(${JSON.stringify(target)});`}></script>
</head>
<body>
<p>Esta sección se movió. Redirigiendo a <a href={target}>{target}</a>…</p>
</body>
</html>
