---
/**
 * GSC FIX: /categoria/{x}/ → /tema/{cluster}/  (o home si no hay match)
 * Emite páginas redirect (canonical + refresh + noindex) para consolidar
 * URLs legacy que Google sigue rastreando.
 */
import { CLUSTERS } from '../../lib/clusters';
import { LEGACY_CAT_MAP } from '../../lib/legacy-redirects';

export async function getStaticPaths() {
  const { LEGACY_CAT_MAP } = await import('../../lib/legacy-redirects');
  const { CLUSTERS } = await import('../../lib/clusters');
  const all = new Set<string>([
    ...Object.keys(LEGACY_CAT_MAP),
    ...Object.keys(CLUSTERS),
  ]);
  return Array.from(all).map((slug) => ({ params: { slug }, props: { slug } }));
}

const { slug } = Astro.props as { slug: string };
const targetCluster = LEGACY_CAT_MAP[slug] || (CLUSTERS[slug] ? slug : '');
const target = targetCluster
  ? `https://blog.vistaceo.com/tema/${targetCluster}/`
  : `https://blog.vistaceo.com/`;
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<title>Redirigiendo…</title>
<link rel="canonical" href={target} />
<meta name="robots" content="noindex, follow" />
<meta http-equiv="refresh" content={`0; url=${target}`} />
<script is:inline set:html={`window.location.replace(${JSON.stringify(target)});`}></script>
</head>
<body>
<p>Esta sección se movió. Redirigiendo a <a href={target}>{target}</a>…</p>
</body>
</html>
