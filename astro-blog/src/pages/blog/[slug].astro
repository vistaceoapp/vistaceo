---
/**
 * GSC FIX: /blog/{slug}/ → /{slug}/
 * Canonical + meta refresh + JS replace + noindex para consolidar URLs viejas
 * que GH Pages no puede redirigir con un 301 real.
 *
 * IMPORTANTE: getStaticPaths corre en módulo aislado — todo lo que necesita
 * se importa dinámicamente adentro y el target se pasa por props.
 */
export async function getStaticPaths() {
  const { getAllPublishedPosts, getAllRedirects } = await import('../../lib/supabase');
  const [posts, redirects] = await Promise.all([
    getAllPublishedPosts(),
    getAllRedirects(),
  ]);
  const slugs = new Set<string>();
  for (const p of posts) slugs.add(p.slug);
  for (const r of redirects) slugs.add(r.from_slug);
  return Array.from(slugs).map((slug) => ({
    params: { slug },
    props: { target: `https://blog.vistaceo.com/${slug}/` },
  }));
}

const { target } = Astro.props as { target: string };
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8" />
<title>Redirigiendo…</title>
<link rel="canonical" href={target} />
<meta name="robots" content="noindex, follow" />
<meta http-equiv="refresh" content={`0; url=${target}`} />
<script is:inline set:html={`window.location.replace(${JSON.stringify(target)});`}></script>
</head>
<body>
<p>Esta nota se movió. Redirigiendo a <a href={target}>{target}</a>…</p>
</body>
</html>
