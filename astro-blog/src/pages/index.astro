---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getAllPublishedPosts, getClusterStats } from '../lib/supabase';
import { generateWebSiteSchema, generateOrganizationSchema } from '../lib/seo';
import { getAllClusters } from '../lib/clusters';
import { formatDate, truncate } from '../lib/text';

const posts = await getAllPublishedPosts();
const clusters = getAllClusters();
const MAIN = 'https://www.vistaceo.com';

const schemas = [generateWebSiteSchema(), generateOrganizationSchema()];

// Count posts per cluster
const clusterCounts: Record<string, number> = {};
posts.forEach(p => {
  if (p.category) clusterCounts[p.category] = (clusterCounts[p.category] || 0) + 1;
});
const activeClusters = clusters.filter(c => (clusterCounts[c.slug] || 0) > 0);

// Featured post = most recent
const featured = posts[0];
const restPosts = posts.slice(1);
---

<BaseLayout
  title="VISTACEO Blog — Recursos para hacer crecer tu negocio"
  description="Artículos, guías y recursos prácticos sobre liderazgo, IA aplicada, emprendimiento y finanzas para dueños de negocios en Latinoamérica."
  canonical="https://blog.vistaceo.com/"
  schemas={schemas}
>
  <Header />

  <main class="blog-main">
    <!-- Hero -->
    <section class="hero">
      <div class="hero-bg">
        <div class="hero-orb hero-orb-1"></div>
        <div class="hero-orb hero-orb-2"></div>
      </div>
      <div class="hero-content">
        <h1>
          Inteligencia de negocios<br/>
          <span class="text-gradient">para quienes lideran</span>
        </h1>
        <p class="hero-sub">
          Guías prácticas, estrategias y recursos para tomar mejores decisiones y hacer crecer tu negocio.
        </p>

      </div>
    </section>

    <!-- Category pills -->
    <section class="filters" id="explorar">
      <div class="filters-inner">
        <button class="pill active" data-cat="all">Todos</button>
        {activeClusters.map(c => (
          <a href={`/tema/${c.slug}`} class="pill" data-cat={c.slug}>
            {c.name}
            <span class="pill-count">{clusterCounts[c.slug]}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Featured post -->
    {featured && (
      <section class="featured-section">
        <div class="container">
          <a href={`/${featured.slug}`} class="featured-card">
            {featured.hero_image_url && (
              <div class="featured-img">
                <img src={featured.hero_image_url} alt={featured.image_alt_text || featured.title} loading="eager" />
              </div>
            )}
            <div class="featured-body">
              {featured.category && (
                <span class="badge">{clusters.find(c => c.slug === featured.category)?.name || featured.category}</span>
              )}
              <h2>{featured.title}</h2>
              {featured.excerpt && <p class="featured-excerpt">{truncate(featured.excerpt, 180)}</p>}
              <div class="featured-meta">
                {featured.reading_time_min && <span>{featured.reading_time_min} min de lectura</span>}
                <span>{formatDate(featured.publish_at || featured.created_at)}</span>
              </div>
            </div>
          </a>
        </div>
      </section>
    )}

    <!-- Post grid -->
    <section class="posts-section">
      <div class="container">
        <div class="section-header">
          <h2>Últimos artículos</h2>
          <p class="posts-count" id="posts-count">{restPosts.length} artículos</p>
        </div>
        <div class="posts-grid" id="posts-grid">
          {restPosts.map((post, i) => (
            <a
              href={`/${post.slug}`}
              class="post-card"
              data-title={post.title.toLowerCase()}
              data-cat={post.category || ''}
              style={i >= 12 ? 'display:none' : ''}
              data-index={i}
            >
              {post.hero_image_url ? (
                <div class="card-img">
                  <img src={post.hero_image_url} alt={post.image_alt_text || post.title} loading="lazy" />
                </div>
              ) : (
                <div class="card-img card-img-placeholder">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3">
                    <path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                  </svg>
                </div>
              )}
              <div class="card-body">
                {post.category && (
                  <span class="card-badge">{clusters.find(c => c.slug === post.category)?.name || post.category}</span>
                )}
                <h3>{post.title}</h3>
                {post.excerpt && <p class="card-excerpt">{truncate(post.excerpt, 120)}</p>}
                <div class="card-meta">
                  {post.reading_time_min && <span>{post.reading_time_min} min</span>}
                  <span>{formatDate(post.publish_at || post.created_at)}</span>
                </div>
              </div>
            </a>
          ))}
        </div>
        {restPosts.length > 12 && (
          <div class="load-more-wrap" id="load-more-wrap">
            <button class="btn-load-more" id="btn-load-more">
              Ver más artículos
              <span class="load-more-count" id="load-more-count">({restPosts.length - 12} restantes)</span>
            </button>
          </div>
        )}
        <p class="no-results" id="no-results" style="display:none;">
          No se encontraron artículos. Probá con otra búsqueda.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="cta-section">
      <div class="container">
        <div class="cta-card">
          <h2>¿Listo para hacer crecer tu negocio?</h2>
          <p>VISTACEO detecta oportunidades y genera misiones accionables con inteligencia artificial.</p>
          <a href={`${MAIN}/auth`} class="btn-hero-lg">
            Empezar gratis
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>


<style>
  .blog-main {
    padding-top: 5rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* ── Hero ── */
  .hero {
    position: relative;
    padding: 5rem 1.5rem 3rem;
    text-align: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
  }
  .hero-orb-1 {
    width: 500px; height: 500px;
    top: -10%; left: 20%;
    background: rgba(38,146,220,0.08);
    animation: pulse-orb 8s ease-in-out infinite;
  }
  .hero-orb-2 {
    width: 400px; height: 400px;
    bottom: -20%; right: 15%;
    background: rgba(116,108,230,0.06);
    animation: pulse-orb 10s ease-in-out infinite 2s;
  }
  @keyframes pulse-orb {
    0%, 100% { transform: scale(1); opacity: 0.6; }
    50% { transform: scale(1.15); opacity: 1; }
  }

  .hero-content {
    position: relative;
    max-width: 680px;
    margin: 0 auto;
  }

  .hero h1 {
    font-size: clamp(1.75rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--foreground);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .text-gradient {
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-sub {
    font-size: 1.1rem;
    color: var(--foreground-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .search-wrap {
    position: relative;
    max-width: 440px;
    margin: 0 auto;
  }
  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--foreground-muted);
    pointer-events: none;
  }
  .search-wrap input {
    width: 100%;
    padding: 0.875rem 1rem 0.875rem 2.75rem;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 1rem;
    font-size: 0.95rem;
    color: var(--foreground);
    outline: none;
    transition: border-color 200ms, box-shadow 200ms;
  }
  .search-wrap input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(38,146,220,0.1);
  }
  .search-wrap input::placeholder {
    color: var(--foreground-muted);
  }

  /* ── Filters ── */
  .filters {
    padding: 0 1.5rem 2rem;
    max-width: 1200px;
    margin: 0 auto;
  }
  .filters-inner {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }
  .filters-inner::-webkit-scrollbar { display: none; }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 1rem;
    background: var(--muted);
    color: var(--foreground-muted);
    border: 1px solid var(--border);
    border-radius: 2rem;
    font-size: 0.8rem;
    font-weight: 500;
    white-space: nowrap;
    text-decoration: none;
    cursor: pointer;
    transition: all 200ms;
  }
  .pill:hover {
    color: var(--foreground);
    border-color: var(--primary);
    background: rgba(38,146,220,0.06);
  }
  .pill.active {
    background: var(--gradient-primary);
    color: #fff;
    border-color: transparent;
  }
  .pill-count {
    font-size: 0.7rem;
    opacity: 0.7;
  }

  /* ── Featured ── */
  .featured-section {
    padding: 0 0 3rem;
  }
  .featured-card {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 300ms, box-shadow 300ms;
  }
  .featured-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 768px) {
    .featured-card {
      grid-template-columns: 1.2fr 1fr;
    }
  }

  .featured-img {
    aspect-ratio: 16/9;
    overflow: hidden;
  }
  .featured-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 500ms;
  }
  .featured-card:hover .featured-img img {
    transform: scale(1.03);
  }

  .featured-body {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .badge {
    display: inline-block;
    padding: 0.3rem 0.75rem;
    background: rgba(38,146,220,0.1);
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 2rem;
    margin-bottom: 0.75rem;
    width: fit-content;
  }

  .featured-body h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--foreground);
    line-height: 1.3;
    margin-bottom: 0.75rem;
  }

  .featured-excerpt {
    color: var(--foreground-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .featured-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--foreground-muted);
  }

  /* ── Post grid ── */
  .posts-section {
    padding: 0 0 4rem;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
  }
  .section-header h2 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--foreground);
  }
  .posts-count {
    font-size: 0.85rem;
    color: var(--foreground-muted);
  }

  .posts-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  @media (min-width: 640px) {
    .posts-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 1024px) {
    .posts-grid { grid-template-columns: repeat(3, 1fr); }
  }

  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: transform 300ms, box-shadow 300ms, border-color 300ms;
  }
  .post-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: rgba(38,146,220,0.2);
  }

  .card-img {
    aspect-ratio: 16/10;
    overflow: hidden;
    background: var(--muted);
  }
  .card-img img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 400ms;
  }
  .post-card:hover .card-img img {
    transform: scale(1.04);
  }
  .card-img-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .card-badge {
    display: inline-block;
    padding: 0.2rem 0.6rem;
    background: rgba(38,146,220,0.08);
    color: var(--primary);
    font-size: 0.7rem;
    font-weight: 600;
    border-radius: 2rem;
    margin-bottom: 0.5rem;
    width: fit-content;
  }

  .card-body h3 {
    font-size: 1rem;
    font-weight: 600;
    color: var(--foreground);
    line-height: 1.35;
    margin-bottom: 0.5rem;
  }

  .card-excerpt {
    font-size: 0.85rem;
    color: var(--foreground-muted);
    line-height: 1.5;
    flex: 1;
    margin-bottom: 0.75rem;
  }

  .card-meta {
    display: flex;
    gap: 0.75rem;
    font-size: 0.75rem;
    color: var(--foreground-muted);
  }

  .no-results {
    text-align: center;
    padding: 3rem 0;
    color: var(--foreground-muted);
    font-size: 1rem;
  }

  /* ── CTA ── */
  .cta-section {
    padding: 0 0 2rem;
  }
  .cta-card {
    text-align: center;
    padding: 4rem 2rem;
    background: var(--gradient-primary);
    border-radius: var(--radius-xl);
    color: #fff;
  }
  .cta-card h2 {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }
  .cta-card p {
    opacity: 0.9;
    margin-bottom: 1.5rem;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }
  .btn-hero-lg {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.9rem 2rem;
    background: #fff;
    color: var(--primary);
    font-weight: 700;
    text-decoration: none;
    border-radius: 1rem;
    font-size: 1rem;
    box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    transition: transform 200ms, box-shadow 200ms;
  }
  .btn-hero-lg:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.2);
  }


  /* ── Load More ── */
  .load-more-wrap {
    text-align: center;
    padding: 2.5rem 0 1rem;
  }
  .btn-load-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 2rem;
    background: var(--muted);
    color: var(--foreground);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    border: 1px solid var(--border);
    border-radius: 2rem;
    cursor: pointer;
    transition: all 200ms;
  }
  .btn-load-more:hover {
    background: rgba(38,146,220,0.06);
    border-color: var(--primary);
    color: var(--primary);
  }
  .load-more-count {
    font-weight: 400;
    opacity: 0.6;
    font-size: 0.8rem;
  }
</style>

<script>
  // Load more posts
  const loadMoreBtn = document.getElementById('btn-load-more');
  const loadMoreWrap = document.getElementById('load-more-wrap');
  const grid = document.getElementById('posts-grid');

  if (loadMoreBtn && grid) {
    let shown = 12;
    const BATCH = 12;
    const cards = Array.from(grid.querySelectorAll('.post-card')) as HTMLElement[];

    loadMoreBtn.addEventListener('click', () => {
      const next = Math.min(shown + BATCH, cards.length);
      for (let i = shown; i < next; i++) {
        cards[i].style.display = '';
      }
      shown = next;

      const remaining = cards.length - shown;
      const countEl = document.getElementById('load-more-count');
      if (remaining <= 0) {
        loadMoreWrap?.remove();
      } else if (countEl) {
        countEl.textContent = `(${remaining} restantes)`;
      }
    });
  }
</script>
