---
// Header — EXACT pixel-perfect clone of vistaceo.com header
// Always light background, regardless of blog dark mode
const MAIN = 'https://www.vistaceo.com';

const navLinks = [
  { label: 'Producto', href: `${MAIN}/#producto` },
  { label: 'Cómo funciona', href: `${MAIN}/#como-funciona` },
  { label: 'Precios', href: `${MAIN}/#precios` },
  { label: 'Blog', href: '/', active: true },
  { label: 'Preguntas frecuentes', href: `${MAIN}/#faq` },
];
---

<header class="vc-header" id="site-header">
  <div class="vc-header-container">
    <div class="vc-header-inner">
      <!-- Logo -->
      <a href={MAIN} class="vc-brand" aria-label="VISTACEO">
        <img src="/favicon.png" alt="" width="28" height="28" class="vc-brand-icon" />
        <span class="vc-brand-sep"></span>
        <span class="vc-brand-text">VISTACEO</span>
      </a>

      <!-- Desktop nav -->
      <nav class="vc-nav" aria-label="Principal">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={['vc-nav-link', { 'vc-nav-active': link.active }]}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- Actions -->
      <div class="vc-actions">
        <a href={`${MAIN}/auth`} class="vc-btn-login">Ingresar</a>
        <a href={`${MAIN}/auth`} class="vc-btn-cta">
          Empezar gratis
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Mobile toggle -->
      <button class="vc-mobile-btn" id="mobile-btn" aria-label="Menú" aria-expanded="false">
        <svg class="vc-ico-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
        <svg class="vc-ico-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div class="vc-mobile-panel" id="mobile-panel">
    <nav class="vc-mobile-nav">
      {navLinks.map(link => (
        <a href={link.href} class:list={['vc-mobile-link', { 'vc-mobile-active': link.active }]}>
          {link.label}
        </a>
      ))}
      <div class="vc-mobile-sep"></div>
      <a href={`${MAIN}/auth`} class="vc-mobile-login">Ingresar</a>
      <a href={`${MAIN}/auth`} class="vc-mobile-cta">
        Empezar gratis
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('mobile-btn');
  const panel = document.getElementById('mobile-panel');

  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  btn?.addEventListener('click', () => {
    const open = panel?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
    const io = btn.querySelector('.vc-ico-open') as HTMLElement;
    const ic = btn.querySelector('.vc-ico-close') as HTMLElement;
    if (io) io.style.display = open ? 'none' : 'block';
    if (ic) ic.style.display = open ? 'block' : 'none';
  });

  document.querySelectorAll('.vc-mobile-link, .vc-mobile-login, .vc-mobile-cta').forEach(l =>
    l.addEventListener('click', () => {
      panel?.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
      const io = btn?.querySelector('.vc-ico-open') as HTMLElement;
      const ic = btn?.querySelector('.vc-ico-close') as HTMLElement;
      if (io) io.style.display = 'block';
      if (ic) ic.style.display = 'none';
    })
  );
</script>

<style>
  /* ═══════════════════════════════════════════════════
     EXACT CLONE of vistaceo.com header
     ALWAYS light — ignores dark mode on purpose
     ═══════════════════════════════════════════════════ */

  .vc-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    background: #ffffff;
    transition: box-shadow 300ms, border-color 300ms;
    border-bottom: 1px solid transparent;
  }
  .vc-header.scrolled {
    box-shadow: 0 1px 8px rgba(0,0,0,0.06);
    border-bottom-color: #e5e7eb;
  }

  .vc-header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 640px) {
    .vc-header-container { padding: 0 1.5rem; }
  }

  .vc-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  /* ── Brand ── */
  .vc-brand {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    flex-shrink: 0;
  }
  .vc-brand-icon {
    width: 28px; height: 28px;
    object-fit: contain;
  }
  .vc-brand-sep {
    width: 1px;
    height: 20px;
    background: #d1d5db;
    flex-shrink: 0;
  }
  .vc-brand-text {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.14em;
    color: #111827;
    line-height: 1;
    white-space: nowrap;
  }

  /* ── Desktop nav ── */
  .vc-nav {
    display: none;
    align-items: center;
    gap: 0;
    margin-left: 2rem;
  }
  @media (min-width: 900px) {
    .vc-nav { display: flex; }
  }

  .vc-nav-link {
    padding: 0.5rem 0.875rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: #4b5563;
    text-decoration: none;
    transition: color 150ms;
    white-space: nowrap;
  }
  .vc-nav-link:hover {
    color: #111827;
  }
  .vc-nav-active {
    color: #111827;
    font-weight: 600;
  }

  /* ── Actions ── */
  .vc-actions {
    display: none;
    align-items: center;
    gap: 0.75rem;
    margin-left: auto;
  }
  @media (min-width: 900px) {
    .vc-actions { display: flex; }
  }

  .vc-btn-login {
    padding: 0.5rem 0.75rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    color: #4b5563;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: color 150ms;
  }
  .vc-btn-login:hover {
    color: #111827;
  }

  .vc-btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.625rem 1.25rem;
    background: linear-gradient(135deg, #2692DC, #746CE6);
    color: #ffffff;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(38,146,220,0.25);
    transition: transform 200ms, box-shadow 200ms;
    white-space: nowrap;
  }
  .vc-btn-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 8px 24px rgba(38,146,220,0.35);
  }
  .vc-btn-cta svg {
    transition: transform 200ms;
  }
  .vc-btn-cta:hover svg {
    transform: translateX(2px);
  }

  /* ── Mobile button ── */
  .vc-mobile-btn {
    display: flex;
    padding: 0.5rem;
    background: none;
    border: none;
    color: #374151;
    cursor: pointer;
    border-radius: 0.5rem;
    transition: background 150ms;
  }
  .vc-mobile-btn:hover { background: #f3f4f6; }
  @media (min-width: 900px) {
    .vc-mobile-btn { display: none; }
  }

  .vc-ico-close { display: none; }

  /* ── Mobile panel ── */
  .vc-mobile-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 300ms ease, opacity 300ms ease;
    opacity: 0;
    background: #ffffff;
  }
  .vc-mobile-panel.open {
    max-height: 28rem;
    opacity: 1;
  }
  @media (min-width: 900px) {
    .vc-mobile-panel { display: none; }
  }

  .vc-mobile-nav {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1rem 1.5rem;
    border-top: 1px solid #e5e7eb;
  }

  .vc-mobile-link {
    padding: 0.875rem 0.75rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 500;
    color: #374151;
    text-decoration: none;
    border-bottom: 1px solid #f3f4f6;
    transition: color 150ms;
  }
  .vc-mobile-link:last-of-type {
    border-bottom: none;
  }
  .vc-mobile-link:hover {
    color: #111827;
  }
  .vc-mobile-active {
    color: #111827;
    font-weight: 600;
  }

  .vc-mobile-sep {
    height: 1px;
    background: #e5e7eb;
    margin: 0.5rem 0;
  }

  .vc-mobile-login {
    padding: 0.875rem 0.75rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 500;
    color: #6b7280;
    text-decoration: none;
    text-align: left;
    transition: color 150ms;
  }
  .vc-mobile-login:hover { color: #111827; }

  .vc-mobile-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    margin-top: 0.5rem;
    background: linear-gradient(135deg, #2692DC, #746CE6);
    color: #ffffff;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 9999px;
    box-shadow: 0 4px 16px rgba(38,146,220,0.25);
  }
</style>
