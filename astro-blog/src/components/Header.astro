---
const MAIN = 'https://www.vistaceo.com';

const navLinks = [
  { label: 'Producto', href: `${MAIN}/#producto` },
  { label: 'Cómo funciona', href: `${MAIN}/#como-funciona` },
  { label: 'Precios', href: `${MAIN}/#precios` },
  { label: 'Blog', href: '/' },
  { label: 'Preguntas frecuentes', href: `${MAIN}/#faq` },
];
---

<header class="vc-header" id="site-header">
  <div class="vc-header-container">
    <div class="vc-header-inner">
      <a href={MAIN} class="vc-brand" aria-label="VISTACEO">
        <img src="/icon-vistaceo-new.webp" alt="VistaCEO" width="18" height="18" class="vc-brand-icon" />
        <span class="vc-brand-sep"></span>
        <span class="vc-brand-text">VISTACEO</span>
      </a>

      <nav class="vc-nav" aria-label="Principal">
        {navLinks.map((link) => (
          <a href={link.href} class="vc-nav-link">
            {link.label}
          </a>
        ))}
      </nav>

      <div class="vc-actions">
        <a href={`${MAIN}/auth`} class="vc-btn-login">Ingresar</a>
        <a href={`${MAIN}/auth`} class="vc-btn-cta">
          Empezar gratis
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
        </a>
      </div>

      <button class="vc-mobile-btn" id="mobile-btn" aria-label="Menú" aria-expanded="false">
        <svg class="vc-ico-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"></line><line x1="4" y1="12" x2="20" y2="12"></line><line x1="4" y1="18" x2="20" y2="18"></line></svg>
        <svg class="vc-ico-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
  </div>

  <div class="vc-mobile-panel" id="mobile-panel">
    <nav class="vc-mobile-nav">
      {navLinks.map((link) => (
        <a href={link.href} class="vc-mobile-link">
          {link.label}
        </a>
      ))}
      <div class="vc-mobile-sep"></div>
      <a href={`${MAIN}/auth`} class="vc-mobile-login">Ingresar</a>
      <a href={`${MAIN}/auth`} class="vc-mobile-cta">
        Empezar gratis
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('mobile-btn');
  const panel = document.getElementById('mobile-panel');

  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  btn?.addEventListener('click', () => {
    const open = panel?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
    const io = btn.querySelector('.vc-ico-open');
    const ic = btn.querySelector('.vc-ico-close');
    if (io instanceof HTMLElement) io.style.display = open ? 'none' : 'block';
    if (ic instanceof HTMLElement) ic.style.display = open ? 'block' : 'none';
  });

  document.querySelectorAll('.vc-mobile-link, .vc-mobile-login, .vc-mobile-cta').forEach((link) => {
    link.addEventListener('click', () => {
      panel?.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
      const io = btn?.querySelector('.vc-ico-open');
      const ic = btn?.querySelector('.vc-ico-close');
      if (io instanceof HTMLElement) io.style.display = 'block';
      if (ic instanceof HTMLElement) ic.style.display = 'none';
    });
  });
</script>

<style>
  .vc-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    background: hsl(0 0% 100% / 0.96);
    border-bottom: 1px solid hsl(220 13% 91% / 0.75);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    transition: box-shadow 220ms ease, border-color 220ms ease, background-color 220ms ease;
  }

  .vc-header.scrolled {
    background: hsl(0 0% 100% / 0.98);
    border-bottom-color: hsl(220 13% 91%);
    box-shadow: 0 12px 32px hsl(222 15% 10% / 0.07);
  }

  .vc-header-container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  @media (min-width: 640px) {
    .vc-header-container {
      padding: 0 1.5rem;
    }
  }

  .vc-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 70px;
  }

  .vc-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
    text-decoration: none;
  }

  .vc-brand-icon {
    width: 18px;
    height: 18px;
    object-fit: contain;
    flex-shrink: 0;
  }

  .vc-brand-sep {
    width: 1px;
    height: 18px;
    background: hsl(220 10% 86%);
    flex-shrink: 0;
  }

  .vc-brand-text {
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    line-height: 1;
    color: hsl(222 15% 10%);
    white-space: nowrap;
  }

  .vc-nav {
    display: none;
    align-items: center;
    margin-left: 1.75rem;
  }

  @media (min-width: 1024px) {
    .vc-nav {
      display: flex;
    }
  }

  .vc-nav-link {
    padding: 0.5rem 0.9rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    color: hsl(220 9% 46%);
    text-decoration: none;
    white-space: nowrap;
    transition: color 160ms ease;
  }

  .vc-nav-link:hover {
    color: hsl(222 15% 10%);
  }

  .vc-actions {
    display: none;
    align-items: center;
    gap: 0.875rem;
    margin-left: auto;
  }

  @media (min-width: 1024px) {
    .vc-actions {
      display: flex;
    }
  }

  .vc-btn-login {
    padding: 0.5rem 0.625rem;
    border-radius: 0.75rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1;
    color: hsl(220 9% 38%);
    text-decoration: none;
    transition: color 160ms ease;
  }

  .vc-btn-login:hover {
    color: hsl(222 15% 10%);
  }

  .vc-btn-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.9rem 1.5rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, hsl(209 73% 56%), hsl(236 74% 67%));
    box-shadow: 0 10px 24px hsl(225 74% 64% / 0.25);
    color: hsl(0 0% 100%);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .vc-btn-cta:hover {
    transform: translateY(-1px);
    box-shadow: 0 14px 30px hsl(225 74% 64% / 0.34);
  }

  .vc-btn-cta svg {
    transition: transform 180ms ease;
  }

  .vc-btn-cta:hover svg {
    transform: translateX(2px);
  }

  .vc-mobile-btn {
    display: flex;
    padding: 0.5rem;
    border: none;
    border-radius: 0.75rem;
    background: transparent;
    color: hsl(220 10% 32%);
    cursor: pointer;
    transition: background-color 160ms ease;
  }

  .vc-mobile-btn:hover {
    background: hsl(220 14% 96%);
  }

  @media (min-width: 1024px) {
    .vc-mobile-btn {
      display: none;
    }
  }

  .vc-ico-close {
    display: none;
  }

  .vc-mobile-panel {
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    background: hsl(0 0% 100% / 0.98);
    border-bottom: 1px solid hsl(220 13% 91% / 0.8);
    transition: max-height 300ms ease, opacity 220ms ease;
  }

  .vc-mobile-panel.open {
    max-height: 32rem;
    opacity: 1;
  }

  @media (min-width: 1024px) {
    .vc-mobile-panel {
      display: none;
    }
  }

  .vc-mobile-nav {
    display: flex;
    flex-direction: column;
    padding: 0.5rem 1rem 1.25rem;
    border-top: 1px solid hsl(220 13% 91%);
  }

  .vc-mobile-link {
    padding: 0.95rem 0.75rem;
    border-bottom: 1px solid hsl(220 14% 96%);
    color: hsl(220 10% 32%);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.2;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .vc-mobile-link:last-of-type {
    border-bottom: none;
  }

  .vc-mobile-link:hover {
    color: hsl(222 15% 10%);
  }

  .vc-mobile-sep {
    height: 1px;
    margin: 0.5rem 0;
    background: hsl(220 13% 91%);
  }

  .vc-mobile-login {
    padding: 0.95rem 0.75rem;
    color: hsl(220 9% 46%);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 500;
    text-align: left;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .vc-mobile-login:hover {
    color: hsl(222 15% 10%);
  }

  .vc-mobile-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    padding: 0.95rem 1.5rem;
    border-radius: 1rem;
    background: linear-gradient(135deg, hsl(209 73% 56%), hsl(236 74% 67%));
    box-shadow: 0 10px 24px hsl(225 74% 64% / 0.25);
    color: hsl(0 0% 100%);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }
</style>
