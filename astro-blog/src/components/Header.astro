---
// Header — EXACT clone of vistaceo.com landing header
const MAIN = 'https://www.vistaceo.com';

const navLinks = [
  { label: 'Producto', href: `${MAIN}/#producto` },
  { label: 'Cómo funciona', href: `${MAIN}/#como-funciona` },
  { label: 'Precios', href: `${MAIN}/#precios` },
  { label: 'Blog', href: '/', active: true },
  { label: 'Preguntas frecuentes', href: `${MAIN}/#faq` },
];
---

<header class="site-header" id="site-header">
  <div class="header-container">
    <div class="header-inner">
      <!-- Logo — icon + VISTACEO wordmark -->
      <a href={MAIN} class="brand" aria-label="VISTACEO">
        <img src="/favicon.png" alt="" width="32" height="32" class="brand-icon" />
        <span class="brand-text">VISTACEO</span>
      </a>

      <!-- Desktop nav -->
      <nav class="nav-desktop" aria-label="Principal">
        {navLinks.map(link => (
          <a
            href={link.href}
            class:list={['nav-link', { active: link.active }]}
          >
            {link.label}
            <span class="nav-underline" />
          </a>
        ))}
      </nav>

      <!-- Actions -->
      <div class="header-actions">
        <a href={`${MAIN}/auth`} class="btn-ghost">Ingresar</a>
        <a href={`${MAIN}/auth`} class="btn-hero">
          Empezar gratis
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>

      <!-- Mobile toggle -->
      <button class="mobile-btn" id="mobile-btn" aria-label="Menú" aria-expanded="false">
        <svg class="ico-open" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
        <svg class="ico-close" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile panel -->
  <div class="mobile-panel" id="mobile-panel">
    <nav class="mobile-nav">
      {navLinks.map(link => (
        <a href={link.href} class:list={['mobile-link', { active: link.active }]}>
          {link.label}
        </a>
      ))}
      <div class="mobile-divider"></div>
      <a href={`${MAIN}/auth`} class="mobile-ghost">Ingresar</a>
      <a href={`${MAIN}/auth`} class="mobile-hero">
        Empezar gratis
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const btn = document.getElementById('mobile-btn');
  const panel = document.getElementById('mobile-panel');

  window.addEventListener('scroll', () => {
    header?.classList.toggle('scrolled', window.scrollY > 20);
  }, { passive: true });

  btn?.addEventListener('click', () => {
    const open = panel?.classList.toggle('open');
    btn.setAttribute('aria-expanded', String(!!open));
  });

  document.querySelectorAll('.mobile-link').forEach(l =>
    l.addEventListener('click', () => {
      panel?.classList.remove('open');
      btn?.setAttribute('aria-expanded', 'false');
    })
  );
</script>

<style>
  /* ── Header shell ── */
  .site-header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 50;
    background: transparent;
    transition: background 300ms, border-color 300ms, backdrop-filter 300ms;
    border-bottom: 1px solid transparent;
  }
  .site-header.scrolled {
    background: rgba(255,255,255,0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom-color: var(--border-light);
  }
  :global(.dark) .site-header.scrolled {
    background: rgba(0,0,0,0.82);
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 640px) {
    .header-container { padding: 0 1.5rem; }
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 2.5rem;
    padding: 1.25rem 0;
  }
  @media (min-width: 768px) {
    .header-inner { height: 3rem; }
  }

  /* ── Brand ── */
  .brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    transition: transform 300ms;
  }
  .brand:hover { transform: scale(1.05); }

  .brand-icon {
    width: 32px; height: 32px;
    object-fit: contain;
  }
  .brand-text {
    font-family: 'Codec Pro', 'Inter', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.18em;
    color: var(--foreground);
    line-height: 1;
    white-space: nowrap;
  }

  /* ── Desktop nav ── */
  .nav-desktop {
    display: none;
    align-items: center;
    gap: 0.25rem;
  }
  @media (min-width: 768px) {
    .nav-desktop { display: flex; }
  }

  .nav-link {
    position: relative;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--foreground-muted);
    text-decoration: none;
    transition: color 200ms;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--foreground);
  }

  .nav-underline {
    position: absolute;
    bottom: 0;
    left: 50%; right: 50%;
    height: 2px;
    background: var(--gradient-primary);
    border-radius: 999px;
    transition: left 300ms, right 300ms;
  }
  .nav-link:hover .nav-underline,
  .nav-link.active .nav-underline {
    left: 25%; right: 25%;
  }

  /* ── Actions ── */
  .header-actions {
    display: none;
    align-items: center;
    gap: 0.75rem;
  }
  @media (min-width: 768px) {
    .header-actions { display: flex; }
  }

  .btn-ghost {
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: var(--foreground-muted);
    text-decoration: none;
    border-radius: 0.5rem;
    transition: color 200ms, background 200ms;
  }
  .btn-ghost:hover {
    color: var(--foreground);
    background: rgba(0,0,0,0.04);
  }

  .btn-hero {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.625rem 1.25rem;
    background: var(--gradient-primary);
    color: #fff;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.75rem;
    box-shadow: 0 8px 24px rgba(38,146,220,0.2);
    transition: transform 200ms, box-shadow 200ms;
  }
  .btn-hero:hover {
    transform: translateY(-1px);
    box-shadow: 0 12px 28px rgba(38,146,220,0.3);
  }
  .btn-hero svg {
    transition: transform 200ms;
  }
  .btn-hero:hover svg {
    transform: translateX(2px);
  }

  /* ── Mobile ── */
  .mobile-btn {
    display: flex;
    padding: 0.5rem;
    background: none;
    border: none;
    color: var(--foreground);
    cursor: pointer;
    border-radius: 0.5rem;
    transition: background 200ms;
  }
  .mobile-btn:hover { background: rgba(0,0,0,0.04); }
  @media (min-width: 768px) {
    .mobile-btn { display: none; }
  }

  .ico-close { display: none; }
  .mobile-panel.open ~ .header-container .ico-open,
  :global(.site-header) .mobile-panel.open ~ * .ico-open { display: none; }

  /* JS toggles .open on panel, but icons are in btn outside panel */
  :global(#site-header[aria-expanded="true"]) .ico-open { display: none; }

  .mobile-panel {
    max-height: 0;
    overflow: hidden;
    transition: max-height 300ms, opacity 300ms;
    opacity: 0;
  }
  .mobile-panel.open {
    max-height: 24rem;
    opacity: 1;
    padding-bottom: 1rem;
  }
  @media (min-width: 768px) {
    .mobile-panel { display: none; }
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.5rem 0;
    border-top: 1px solid var(--border);
  }

  .mobile-link {
    padding: 0.75rem 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--foreground-muted);
    text-decoration: none;
    border-radius: 0.5rem;
    transition: color 200ms, background 200ms;
  }
  .mobile-link:hover,
  .mobile-link.active {
    color: var(--foreground);
    background: var(--muted);
  }

  .mobile-divider {
    height: 1px;
    background: var(--border);
    margin: 0.5rem 0;
  }

  .mobile-ghost {
    padding: 0.75rem 1rem;
    text-align: center;
    color: var(--foreground-muted);
    text-decoration: none;
    border-radius: 0.5rem;
    transition: color 200ms;
  }
  .mobile-ghost:hover { color: var(--foreground); }

  .mobile-hero {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.75rem;
    background: var(--gradient-primary);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.75rem;
  }
</style>

<script>
  // Icon toggle via JS
  const mbtn = document.getElementById('mobile-btn');
  const mpan = document.getElementById('mobile-panel');
  if (mbtn && mpan) {
    const io = mbtn.querySelector('.ico-open');
    const ic = mbtn.querySelector('.ico-close');
    const observer = new MutationObserver(() => {
      const isOpen = mpan.classList.contains('open');
      if (io) (io as HTMLElement).style.display = isOpen ? 'none' : 'block';
      if (ic) (ic as HTMLElement).style.display = isOpen ? 'block' : 'none';
    });
    observer.observe(mpan, { attributes: true, attributeFilter: ['class'] });
  }
</script>
