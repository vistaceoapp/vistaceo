---
import { getAllClusters } from '../lib/clusters';

const clusters = getAllClusters();
const MAIN = 'https://www.vistaceo.com';

const productLinks = [
  { label: 'Cómo funciona', href: `${MAIN}/#how-it-works` },
  { label: 'Características', href: `${MAIN}/#features` },
  { label: 'Precios', href: `${MAIN}/#pricing` },
  { label: 'Blog', href: '/' },
];

const topicLinks = clusters.slice(0, 6).map(c => ({
  label: c.name,
  href: `/tema/${c.slug}`,
}));

const legalLinks = [
  { label: 'Privacidad', href: `${MAIN}/politicas` },
  { label: 'Términos', href: `${MAIN}/condiciones` },
];
---

<footer class="site-footer">
  <div class="footer-container">
    <div class="footer-grid">
      <!-- Brand -->
      <div class="footer-brand">
        <a href={MAIN} class="footer-logo" aria-label="VISTACEO">
          <img src="/favicon.png" alt="VistaCEO" width="28" height="28" />
          <span class="footer-wordmark">VISTACEO</span>
        </a>
        <p class="footer-tagline">
          Inteligencia artificial que hace crecer tu negocio. Detecta oportunidades, entrega insights y genera misiones accionables.
        </p>
      </div>

      <!-- Product -->
      <div class="footer-col">
        <h4>Producto</h4>
        <ul>
          {productLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>

      <!-- Topics -->
      <div class="footer-col">
        <h4>Temas</h4>
        <ul>
          {topicLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>

      <!-- Legal -->
      <div class="footer-col">
        <h4>Legal</h4>
        <ul>
          {legalLinks.map(l => <li><a href={l.href}>{l.label}</a></li>)}
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {new Date().getFullYear()} VISTACEO. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--background);
    padding: 4rem 0 2rem;
    margin-top: 6rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .footer-wordmark {
    font-weight: 600;
    font-size: 0.9rem;
    letter-spacing: 0.18em;
    color: var(--foreground);
  }

  .footer-tagline {
    color: var(--foreground-muted);
    font-size: 0.875rem;
    line-height: 1.6;
    max-width: 320px;
  }

  .footer-col h4 {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--foreground);
    margin-bottom: 1rem;
  }

  .footer-col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .footer-col a {
    color: var(--foreground-muted);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 200ms;
  }
  .footer-col a:hover { color: var(--foreground); }

  .footer-bottom {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    text-align: center;
  }
  .footer-bottom p {
    color: var(--foreground-muted);
    font-size: 0.8rem;
  }
</style>
